# Paper trading placeholders only. Add real credentials later if a paper API is supported.
PAPER_API_BASE_URL=https://paper-api.example.com
PAPER_API_USERNAME=your_paper_username
PAPER_API_PASSWORD=your_paper_password
PAPER_API_TOKEN=your_paper_token

# Existing placeholders kept for compatibility.
ROBINHOOD_USERNAME=your_robinhood_username
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_TOTP_SECRET=your_totp_secret
API_KEY=your_api_key
API_SECRET=your_api_secret
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
TRADING_MODE=PAPER
PAPER_BROKER_BACKEND=ALPACA
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ORDER_SUBMISSION_ENABLED=true
PAPER_MAX_DAILY_ORDERS=5
PAPER_MAX_OPEN_POSITIONS=10
PAPER_MAX_POSITION_EQUITY_PERCENT=5
PAPER_MAX_DAILY_NEW_EXPOSURE_PERCENT=20
PAPER_TUNING_PROFILE_ENABLED=true
PAPER_TUNING_MAX_POSITION_PERCENT=2
PAPER_TUNING_UNKNOWN_SECTOR_MAX_PERCENT=20
PAPER_DAILY_LOSS_STOP_PERCENT=2
MAX_DAILY_ORDERS=5
MAX_OPEN_POSITIONS=10
MAX_POSITION_EQUITY_PERCENT=5
SCAN_INTERVAL_MINUTES=5
SCAN_ONLY_DURING_MARKET_HOURS=true
CONTINUOUS_RUNNER_DRY_RUN=true
PAPER_EXECUTION_ENABLED=false
CONTROLLED_PAPER_VALIDATION=false
# 0 means unlimited (no artificial cap).
SCANNER_MAX_UNIVERSE_SIZE=0
SCANNER_SYMBOL_TIMEOUT_SECONDS=45
SCANNER_DATA_REQUEST_TIMEOUT_SECONDS=45
ALPACA_ASSET_REQUEST_TIMEOUT_SECONDS=20
SCANNER_MAX_RETRIES=2
SCANNER_PROGRESS_EVERY=25
SCANNER_MAX_SCAN_SECONDS=180
SCANNER_MAX_COARSE_CANDIDATES=500
SCANNER_MAX_DEEP_SCORE_SYMBOLS=100
SCANNER_DEEP_SCORE_LIMIT=100
SCANNER_UNIVERSE_CACHE_TTL_SECONDS=300
SECTOR_ENRICHMENT_ENABLED=true
SECTOR_ENRICHMENT_CACHE_PATH=/var/lib/quant-bot/sector-cache.json
SECTOR_ENRICHMENT_MAX_SYMBOLS=30
SECTOR_ENRICHMENT_TIMEOUT_SECONDS=6
SECTOR_ENRICHMENT_TOTAL_TIMEOUT_SECONDS=25
SECTOR_ENRICHMENT_MAX_WORKERS=6
SECTOR_ENRICHMENT_CACHE_TTL_DAYS=30
PAPER_POSITION_GUARD_ENABLED=true
PAPER_POSITION_AUTO_EXIT_ENABLED=true
PAPER_POSITION_STOP_LOSS_PERCENT=4
PAPER_POSITION_TAKE_PROFIT_PERCENT=8
PAPER_POSITION_GUARD_MAX_EXITS_PER_CYCLE=1

# Trade risk planning defaults for paper/simulation workflows.
MAX_RISK_PER_TRADE_PERCENT=1.0
MAX_TOTAL_OPEN_RISK_PERCENT=4.0
ATR_PERIOD=14
STOP_ATR_MULTIPLIER=2.0
TARGET_ATR_MULTIPLIER=3.0
MIN_REWARD_RISK_RATIO=1.5

# Local-only paper execution simulation controls.
LOCAL_PAPER_EXECUTION_ENABLED=true
LOCAL_PAPER_STARTING_CASH=10000
LOCAL_PAPER_POSITION_MONITOR_ENABLED=true
EXIT_CONFLICT_POLICY=STOP_FIRST
PAPER_DAILY_CYCLE_ENABLED=true
PAPER_DAILY_AUTO_ENTRY_EXECUTION=true
PAPER_DAILY_MAX_NEW_POSITIONS=0
PAPER_MAX_OPEN_POSITIONS=0
PAPER_DAILY_REQUIRE_LEDGER_INTEGRITY_PASS=true
PAPER_DAILY_RECONCILIATION_ENABLED=true
PAPER_DAILY_RECONCILIATION_TIME_ET=16:20
PAPER_RECONCILIATION_STATUS_PATH=/var/lib/quant-bot/reconciliation-status.json

# PAPER-only rehearsal for a future controlled LIVE launch. These settings do
# not enable LIVE trading or LIVE order submission.
LIVE_READINESS_MODE=true
LIVE_READINESS_OBSERVATION_DAYS=14
LIVE_READINESS_STATUS_PATH=/var/lib/quant-bot/live-readiness.json
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_ACTIVATION_TOKEN=
LIVE_INITIAL_MAX_POSITION_EQUITY_PERCENT=1
LIVE_DAILY_LOSS_STOP_PERCENT=2
LIVE_MAX_DAILY_ORDERS=5
LIVE_MAX_OPEN_POSITIONS=10
LIVE_KILL_SWITCH_ENABLED=true
LIVE_DUPLICATE_ORDER_PROTECTION=true
LIVE_MAX_MARKET_DATA_AGE_SECONDS=120
NOTIFICATIONS_ENABLED=false
DISCORD_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_MIN_SEVERITY=INFO
NOTIFICATION_EVENT_ALLOWLIST=
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_DEDUP_WINDOW_SECONDS=300
NOTIFICATION_DAILY_SUMMARY_ENABLED=true
NOTIFICATION_WEEKLY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME_ET=16:15
SEND_NOTIFICATION_TEST=false
DISCORD_WEBHOOK_URL=
# Optional private 0600 overlay; defaults to ~/.config/quant-bot/secrets.env.
QUANT_BOT_SECRET_ENV_PATH=
DISCORD_NO_TRADE_NOTIFICATION_MINUTES=60
