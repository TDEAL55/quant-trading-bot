# Local-only paper execution simulation controls.
LOCAL_PAPER_EXECUTION_ENABLED=true
LOCAL_PAPER_STARTING_CASH=10000
LOCAL_PAPER_POSITION_MONITOR_ENABLED=true
EXIT_CONFLICT_POLICY=STOP_FIRST
PAPER_DAILY_CYCLE_ENABLED=true
PAPER_DAILY_AUTO_ENTRY_EXECUTION=true
PAPER_DAILY_MAX_NEW_POSITIONS=0
PAPER_MAX_OPEN_POSITIONS=0
PAPER_DAILY_REQUIRE_LEDGER_INTEGRITY_PASS=true
NOTIFICATIONS_ENABLED=false
DISCORD_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_MIN_SEVERITY=INFO
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_DEDUP_WINDOW_SECONDS=300
NOTIFICATION_DAILY_SUMMARY_ENABLED=true
NOTIFICATION_WEEKLY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME_ET=16:15
SEND_NOTIFICATION_TEST=false
