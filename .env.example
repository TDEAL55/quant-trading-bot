# Paper trading placeholders only. Add real credentials later if a paper API is supported.
PAPER_API_BASE_URL=https://paper-api.example.com
PAPER_API_USERNAME=your_paper_username
PAPER_API_PASSWORD=your_paper_password
PAPER_API_TOKEN=your_paper_token

# Existing placeholders kept for compatibility.
ROBINHOOD_USERNAME=your_robinhood_username
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_TOTP_SECRET=your_totp_secret
API_KEY=your_api_key
API_SECRET=your_api_secret
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
TRADING_MODE=PAPER
PAPER_BROKER_BACKEND=ALPACA
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ORDER_SUBMISSION_ENABLED=true
MAX_DAILY_ORDERS=5
MAX_OPEN_POSITIONS=10
MAX_POSITION_EQUITY_PERCENT=10
SCAN_INTERVAL_MINUTES=5
SCAN_ONLY_DURING_MARKET_HOURS=true
CONTINUOUS_RUNNER_DRY_RUN=false
# Railway must not run the autonomous trading worker unless explicitly enabled.
ALLOW_RAILWAY_TRADING_WORKER=false
# 0 means unlimited (no artificial cap).
SCANNER_MAX_UNIVERSE_SIZE=0
SCANNER_SYMBOL_TIMEOUT_SECONDS=45
SCANNER_DATA_REQUEST_TIMEOUT_SECONDS=45
ALPACA_ASSET_REQUEST_TIMEOUT_SECONDS=20
SCANNER_MAX_RETRIES=2
SCANNER_PROGRESS_EVERY=25
SCANNER_MAX_SCAN_SECONDS=540
SCANNER_UNIVERSE_CACHE_TTL_SECONDS=300

# Trade risk planning defaults for paper/simulation workflows.
MAX_RISK_PER_TRADE_PERCENT=1.0
MAX_TOTAL_OPEN_RISK_PERCENT=4.0
ATR_PERIOD=14
STOP_ATR_MULTIPLIER=2.0
TARGET_ATR_MULTIPLIER=3.0
MIN_REWARD_RISK_RATIO=1.5

# Local-only paper execution simulation controls.
LOCAL_PAPER_EXECUTION_ENABLED=true
LOCAL_PAPER_STARTING_CASH=10000
LOCAL_PAPER_POSITION_MONITOR_ENABLED=true
EXIT_CONFLICT_POLICY=STOP_FIRST
PAPER_DAILY_CYCLE_ENABLED=true
PAPER_DAILY_AUTO_ENTRY_EXECUTION=true
PAPER_DAILY_MAX_NEW_POSITIONS=0
PAPER_MAX_OPEN_POSITIONS=0
PAPER_DAILY_REQUIRE_LEDGER_INTEGRITY_PASS=true
DISCORD_WEBHOOK_URL=
DISCORD_NO_TRADE_NOTIFICATION_MINUTES=60
