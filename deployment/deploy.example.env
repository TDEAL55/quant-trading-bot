APP_ENV=production
DATABASE_URL=sqlite:////var/lib/quant-bot/quant-bot.db
DASHBOARD_APP_AUTH_ENABLED=false
DASHBOARD_EXTERNAL_AUTH_ENABLED=true
TRADING_MODE=PAPER
PAPER_BROKER_BACKEND=ALPACA
ALPACA_API_KEY=REPLACE_ME
ALPACA_API_SECRET=REPLACE_ME
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ORDER_SUBMISSION_ENABLED=true
AUTO_APPROVE_PAPER=true
PAPER_MAX_DAILY_ORDERS=5
PAPER_MAX_OPEN_POSITIONS=10
PAPER_MAX_POSITION_EQUITY_PERCENT=5
PAPER_MAX_DAILY_NEW_EXPOSURE_PERCENT=20
PAPER_DAILY_LOSS_STOP_PERCENT=2
MAX_DAILY_ORDERS=5
MAX_OPEN_POSITIONS=10
MAX_POSITION_EQUITY_PERCENT=5
SCAN_INTERVAL_MINUTES=5
SCAN_ONLY_DURING_MARKET_HOURS=true
CONTINUOUS_RUNNER_DRY_RUN=true
PAPER_EXECUTION_ENABLED=false
CONTROLLED_PAPER_VALIDATION=false
# 0 means unlimited (no artificial cap).
SCANNER_MAX_UNIVERSE_SIZE=0
SCANNER_SYMBOL_TIMEOUT_SECONDS=45
SCANNER_DATA_REQUEST_TIMEOUT_SECONDS=45
ALPACA_ASSET_REQUEST_TIMEOUT_SECONDS=20
SCANNER_MAX_RETRIES=2
SCANNER_PROGRESS_EVERY=25
SCANNER_MAX_SCAN_SECONDS=180
SCANNER_MAX_COARSE_CANDIDATES=500
SCANNER_MAX_DEEP_SCORE_SYMBOLS=100
SCANNER_DEEP_SCORE_LIMIT=100
SCANNER_UNIVERSE_CACHE_TTL_SECONDS=300
SCAN_SYMBOLS=
RUN_TIMEZONE=America/New_York
RUN_HOUR=9
RUN_MINUTE=30
NOTIFICATIONS_ENABLED=false
DISCORD_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_MIN_SEVERITY=INFO
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_DEDUP_WINDOW_SECONDS=300
NOTIFICATION_DAILY_SUMMARY_ENABLED=true
NOTIFICATION_WEEKLY_SUMMARY_ENABLED=true
DAILY_SUMMARY_TIME_ET=16:15
SEND_NOTIFICATION_TEST=false
KILL_SWITCH=false
PAPER_DAILY_CYCLE_ENABLED=true
PAPER_DAILY_AUTO_ENTRY_EXECUTION=true
PAPER_DAILY_MAX_NEW_POSITIONS=0
PAPER_MAX_OPEN_POSITIONS=0
PAPER_DAILY_REQUIRE_LEDGER_INTEGRITY_PASS=true
DISCORD_WEBHOOK_URL=
DISCORD_NO_TRADE_NOTIFICATION_MINUTES=60
