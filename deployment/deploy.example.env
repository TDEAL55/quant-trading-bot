APP_ENV=production
DATABASE_URL=sqlite:////var/lib/quant-bot/quant-bot.db
DASHBOARD_APP_AUTH_ENABLED=false
DASHBOARD_EXTERNAL_AUTH_ENABLED=true
DASHBOARD_BROKER_ACCOUNT_FALLBACK_ENABLED=true
TRADING_MODE=PAPER
PAPER_AGGRESSIVE_TEST_MODE=false
PAPER_BROKER_BACKEND=ALPACA
PAPER_ALLOW_SHORT_SELLING=false
CRYPTO_TRADING_ENABLED=false
CRYPTO_DRY_RUN=true
CRYPTO_SCAN_INTERVAL_MINUTES=1
CRYPTO_SCAN_INTERVAL_SECONDS=10
CRYPTO_BAR_TIMEFRAME_MINUTES=15
CRYPTO_LOOKBACK_BARS=240
CRYPTO_BUY_SCORE=60
CRYPTO_EXIT_SCORE=40
CRYPTO_MAX_POSITION_EQUITY_PERCENT=10
# Use less than 100% so market-price movement cannot overdraw crypto buying power.
CRYPTO_BUYING_POWER_USAGE_PERCENT=95
# Cancel only this bot's own crypto orders when they remain open this long.
CRYPTO_STALE_ORDER_MINUTES=10
CRYPTO_STOP_LOSS_PERCENT=5
CRYPTO_TAKE_PROFIT_PERCENT=10
# 0 scans every active tradable Alpaca USD crypto pair.
CRYPTO_MAX_UNIVERSE_SIZE=0
CRYPTO_EXCLUDE_SYMBOLS=USDC/USD,USDT/USD
CRYPTO_STATUS_PATH=/var/lib/quant-bot/crypto-status.json
CRYPTO_TRADES_LOG_PATH=/var/lib/quant-bot/crypto-trades.jsonl
PAPER_DAILY_RECONCILIATION_ENABLED=true
PAPER_DAILY_RECONCILIATION_TIME_ET=16:20
PAPER_RECONCILIATION_STATUS_PATH=/var/lib/quant-bot/reconciliation-status.json
LIVE_READINESS_MODE=true
LIVE_READINESS_OBSERVATION_DAYS=14
LIVE_READINESS_STATUS_PATH=/var/lib/quant-bot/live-readiness.json
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_ACTIVATION_TOKEN=
LIVE_INITIAL_MAX_POSITION_EQUITY_PERCENT=1
LIVE_DAILY_LOSS_STOP_PERCENT=2
LIVE_MAX_DAILY_ORDERS=5
LIVE_MAX_OPEN_POSITIONS=10
LIVE_KILL_SWITCH_ENABLED=true
LIVE_DUPLICATE_ORDER_PROTECTION=true
LIVE_MAX_MARKET_DATA_AGE_SECONDS=120
OPTIONS_TRADING_ENABLED=false
OPTIONS_DRY_RUN=true
OPTIONS_SCAN_INTERVAL_MINUTES=15
OPTIONS_BAR_TIMEFRAME_MINUTES=15
OPTIONS_LOOKBACK_BARS=240
OPTIONS_CALL_SCORE=60
OPTIONS_PUT_SCORE=40
OPTIONS_UNDERLYINGS=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,TSLA,AMD
OPTIONS_MIN_DTE=14
OPTIONS_MAX_DTE=45
OPTIONS_EXIT_DTE=5
OPTIONS_TARGET_DELTA=0.55
OPTIONS_MAX_SPREAD_PERCENT=35
OPTIONS_MIN_OPEN_INTEREST=0
OPTIONS_MAX_POSITION_EQUITY_PERCENT=10
OPTIONS_STOP_LOSS_PERCENT=25
OPTIONS_TAKE_PROFIT_PERCENT=50
OPTIONS_DATA_FEED=indicative
OPTIONS_STATUS_PATH=/var/lib/quant-bot/options-status.json
OPTIONS_TRADES_LOG_PATH=/var/lib/quant-bot/options-trades.jsonl
ALPACA_API_KEY=REPLACE_ME
ALPACA_API_SECRET=REPLACE_ME
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ORDER_SUBMISSION_ENABLED=true
STOCKS_ONLY_MODE=true
CRYPTO_TRADING_ENABLED=false
OPTIONS_TRADING_ENABLED=false
INTRADAY_TRADING_ENABLED=false
AUTO_APPROVE_PAPER=true
PAPER_MAX_DAILY_ORDERS=5
PAPER_MAX_OPEN_POSITIONS=10
PAPER_MAX_POSITION_EQUITY_PERCENT=5
PAPER_MAX_DAILY_NEW_EXPOSURE_PERCENT=20
CROSS_ASSET_CASH_RESERVE_PERCENT=30
PAPER_TUNING_PROFILE_ENABLED=true
PAPER_TUNING_MAX_POSITION_PERCENT=2
PAPER_TUNING_UNKNOWN_SECTOR_MAX_PERCENT=20
PAPER_DAILY_LOSS_STOP_PERCENT=2
PAPER_MAX_RISK_PER_TRADE_PERCENT=1
PAPER_MAX_CONSECUTIVE_LOSSES=3
PAPER_LOSS_COOLDOWN_MINUTES=60
MAX_DAILY_ORDERS=5
MAX_OPEN_POSITIONS=10
MAX_POSITION_EQUITY_PERCENT=5
SCAN_INTERVAL_MINUTES=5
SCAN_ONLY_DURING_MARKET_HOURS=true
CONTINUOUS_RUNNER_DRY_RUN=true
PAPER_EXECUTION_ENABLED=false
CONTROLLED_PAPER_VALIDATION=false
# 0 means unlimited (no artificial cap).
SCANNER_MAX_UNIVERSE_SIZE=0
SCANNER_SYMBOL_TIMEOUT_SECONDS=45
SCANNER_DATA_REQUEST_TIMEOUT_SECONDS=45
ALPACA_ASSET_REQUEST_TIMEOUT_SECONDS=20
SCANNER_MAX_RETRIES=2
SCANNER_PROGRESS_EVERY=25
SCANNER_MAX_SCAN_SECONDS=180
SCANNER_MAX_COARSE_CANDIDATES=500
SCANNER_MAX_DEEP_SCORE_SYMBOLS=100
SCANNER_SHORT_MAX_SCORE=40
SCANNER_SHORT_MIN_CONFIDENCE=45
SCANNER_SHORT_ALLOWED_SIGNALS=REDUCE,EXIT
SCANNER_DEEP_SCORE_LIMIT=100
SCANNER_UNIVERSE_CACHE_TTL_SECONDS=300
SECTOR_ENRICHMENT_ENABLED=true
SECTOR_ENRICHMENT_CACHE_PATH=/var/lib/quant-bot/sector-cache.json
SECTOR_ENRICHMENT_MAX_SYMBOLS=30
SECTOR_ENRICHMENT_TIMEOUT_SECONDS=6
