# Overlay loaded after the normal paper credential file.
TRADING_MODE=PAPER
PAPER_MICRO_TRIAL_ENABLED=false
PAPER_MICRO_TRIAL_CONFIRMATION=
PAPER_MICRO_KILL_SWITCH=true

ALPACA_ORDER_SUBMISSION_ENABLED=false
STOCKS_ONLY_MODE=true
CRYPTO_TRADING_ENABLED=false
OPTIONS_TRADING_ENABLED=false
PAPER_ALLOW_SHORT_SELLING=false

PAPER_MICRO_MAX_ACCOUNT_EQUITY=500
# PAPER trial only: when false, position size, gross exposure, cash reserve,
# open-position count, and daily entry-count limits are not enforced.
PAPER_MICRO_ENTRY_LIMITS_ENABLED=false
PAPER_MICRO_DAILY_LOSS_STOP_PERCENT=1
PAPER_MICRO_DAILY_LOSS_STOP_DOLLARS=3
PAPER_MICRO_MINIMUM_STRATEGY_SCORE=75
PAPER_MICRO_MINIMUM_CONFIDENCE=70
PAPER_MICRO_STOP_LOSS_PERCENT=5
PAPER_MICRO_TAKE_PROFIT_PERCENT=10
PAPER_MICRO_ALLOWED_SYMBOLS=
PAPER_MICRO_SCAN_INTERVAL_SECONDS=60
PAPER_MICRO_STATE_PATH=/var/lib/quant-bot/paper-micro-state.json
PAPER_MICRO_DASHBOARD_MODE=true
PAPER_MICRO_STARTING_EQUITY=300
