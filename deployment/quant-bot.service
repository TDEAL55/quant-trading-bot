[Unit]
Description=Quant Bot Unattended Paper Daily Run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Restart=no
User=quantbot
Group=quantbot
WorkingDirectory=/home/quantbot/quant-trading-bot
EnvironmentFile=-/etc/quant-bot/quant-bot.env
ExecStart=/home/quantbot/quant-trading-bot/.venv/bin/python /home/quantbot/quant-trading-bot/unattended_daily_runner.py
ExecStartPost=/usr/bin/env bash /home/quantbot/quant-trading-bot/deployment/backup_daily_database.sh
StandardOutput=journal
StandardError=journal
