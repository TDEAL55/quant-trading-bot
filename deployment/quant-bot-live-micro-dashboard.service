[Unit]
Description=Quant Bot Protected LIVE Account Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
User=quantbot
Group=quantbot
WorkingDirectory=/home/quantbot/quant-trading-bot
EnvironmentFile=/etc/quant-bot/quant-bot-live.env
Environment=QUANT_BOT_SECRET_ENV_PATH=/nonexistent/quant-bot-live-no-overlay.env
Environment=PYTHONUNBUFFERED=1
Environment=BOT_LOG_FILE=/var/lib/quant-bot/live-micro-dashboard.log
Environment=DASHBOARD_APP_AUTH_ENABLED=false
Environment=DASHBOARD_EXTERNAL_AUTH_ENABLED=true
Environment=DASHBOARD_DATA_PROFILE=live-micro-account
Environment=DASHBOARD_BROKER_ACCOUNT_FALLBACK_ENABLED=true
Environment=LIVE_DASHBOARD_MODE=true
Environment="DASHBOARD_UI_BUILD_LABEL=LIVE ACCOUNT"
Environment="DASHBOARD_MOBILE_SUBTITLE=STOCKS · LIVE ACCOUNT"
ExecStart=/home/quantbot/quant-trading-bot/.venv/bin/streamlit run /home/quantbot/quant-trading-bot/dashboard_app.py --server.address 127.0.0.1 --server.port 8505 --server.baseUrlPath live --server.headless true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
