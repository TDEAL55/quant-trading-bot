# Separate Alpaca LIVE credentials. Never reuse or paste them into chat.
TRADING_MODE=LIVE
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# All four controls must be deliberately armed. Defaults below cannot trade.
LIVE_TRADING_ENABLED=false
ALPACA_LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_KILL_SWITCH=true
LIVE_PRIVATE_DASHBOARD_CONFIRMED=false

# The initial $300 micro-live envelope cannot be raised above these code caps.
LIVE_MAX_ACCOUNT_EQUITY=500
LIVE_MAX_POSITION_PERCENT=10
LIVE_MAX_POSITION_NOTIONAL=30
LIVE_MAX_GROSS_EXPOSURE_PERCENT=30
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_NEW_ORDERS_PER_DAY=1
LIVE_DAILY_LOSS_STOP_PERCENT=1
LIVE_DAILY_LOSS_STOP_DOLLARS=3
LIVE_MINIMUM_CASH_RESERVE_PERCENT=70
LIVE_MINIMUM_STRATEGY_SCORE=75
LIVE_MINIMUM_CONFIDENCE=70
LIVE_STOP_LOSS_PERCENT=5
LIVE_TAKE_PROFIT_PERCENT=10

# Whole-share, liquid US stocks whose price can fit beneath the $30 order cap.
# Leave empty until each symbol is reviewed immediately before launch.
LIVE_ALLOWED_SYMBOLS=
LIVE_SCAN_INTERVAL_SECONDS=60
LIVE_STATE_PATH=/var/lib/quant-bot/live-micro-state.json
