# Separate Alpaca LIVE credentials. Never reuse or paste them into chat.
TRADING_MODE=LIVE
# Keep config.py from overriding this isolated LIVE environment with the
# quantbot user's shared PAPER secrets overlay.
QUANT_BOT_SECRET_ENV_PATH=/nonexistent/quant-bot-live-no-overlay.env
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# All four controls must be deliberately armed. Defaults below cannot trade.
LIVE_TRADING_ENABLED=false
ALPACA_LIVE_ORDER_SUBMISSION_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_KILL_SWITCH=true
LIVE_PRIVATE_DASHBOARD_CONFIRMED=false

# Use the same entry policy and broad stock universe validated in PAPER.
# Zero disables the obsolete micro-launch account-size ceiling so deposits do
# not pause an otherwise healthy bot. Trade-level risk controls remain active.
LIVE_MAX_ACCOUNT_EQUITY=0
LIVE_ENTRY_LIMITS_ENABLED=false
# Entry count remains unlimited; each new order may use up to 25% of equity.
LIVE_ENTRY_CASH_ALLOCATION_PERCENT=25
LIVE_FULL_STOCK_UNIVERSE=true
LIVE_MAX_UNIVERSE_SIZE=0
LIVE_INCLUDE_ETFS=false
LIVE_DAILY_LOSS_STOP_PERCENT=1
LIVE_DAILY_LOSS_STOP_DOLLARS=3
LIVE_WEEKLY_DRAWDOWN_STOP_PERCENT=3
LIVE_MAX_RISK_PER_TRADE_PERCENT=0.5
LIVE_MAX_CONSECUTIVE_LOSSES=3
LIVE_CONSECUTIVE_LOSS_COOLDOWN_MINUTES=60
LIVE_MAX_CORRELATED_EXPOSURE_PERCENT=20
LIVE_MAX_PAIR_CORRELATION=0.80
LIVE_CORRELATION_LOOKBACK_DAYS=90
LIVE_CORRELATION_MIN_OVERLAP_DAYS=40
LIVE_MINIMUM_STRATEGY_SCORE=75
LIVE_MINIMUM_CONFIDENCE=70
LIVE_STOP_LOSS_PERCENT=5
LIVE_TAKE_PROFIT_PERCENT=10
# Observe strategy-specific trailing-stop ratchets without replacing live
# bracket legs. Promotion to live enforcement requires a separate tested change.
LIVE_TRAILING_STOP_RATCHET_SHADOW_ENABLED=true

# Optional fallback allowlist used only if LIVE_FULL_STOCK_UNIVERSE=false.
LIVE_ALLOWED_SYMBOLS=
LIVE_SCAN_INTERVAL_SECONDS=60
# Monday's 7,819-symbol live scan spent ~154 seconds on a 500-symbol
# lightweight window and timed out halfway through deep scoring. A 400-symbol
# rotating window plus a 240-second deadline preserves broad-universe coverage
# while reserving enough time to score the strongest 100 candidates.
SCANNER_MAX_SCAN_SECONDS=240
SCANNER_MAX_COARSE_CANDIDATES=400
SCANNER_MAX_DEEP_SCORE_SYMBOLS=100
LIVE_STATE_PATH=/var/lib/quant-bot/live-micro-state.json
# Durable observation-only counterfactual exit evidence. This file cannot
# submit, replace, cancel, or close broker orders.
SHADOW_EXIT_TRIAL_LEDGER_PATH=/var/lib/quant-bot/live-shadow-exit-trials.json
BACKTEST_PERFORMANCE_PATH=/var/lib/quant-bot/backtest-performance.json
PAPER_PERFORMANCE_PATH=/var/lib/quant-bot/paper-performance.json
