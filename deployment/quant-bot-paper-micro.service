[Unit]
Description=Quant Bot $300 Controlled PAPER Live-Mirror Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGTERM
User=quantbot
Group=quantbot
WorkingDirectory=/home/quantbot/quant-trading-bot
EnvironmentFile=/etc/quant-bot/quant-bot.env
EnvironmentFile=/etc/quant-bot/paper-micro.env
Environment=PYTHONUNBUFFERED=1
Environment=BOT_LOG_FILE=/var/lib/quant-bot/paper-micro.log
ExecStart=/home/quantbot/quant-trading-bot/.venv/bin/python /home/quantbot/quant-trading-bot/controlled_micro_paper_runner.py
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/quant-bot

[Install]
WantedBy=multi-user.target
