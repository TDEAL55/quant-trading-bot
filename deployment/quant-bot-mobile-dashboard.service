[Unit]
Description=Quant Bot Public Mobile Streamlit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
User=quantbot
Group=quantbot
WorkingDirectory=/home/quantbot/quant-trading-bot
EnvironmentFile=-/etc/quant-bot/quant-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=DASHBOARD_APP_AUTH_ENABLED=false
Environment=DASHBOARD_EXTERNAL_AUTH_ENABLED=true
Environment=DASHBOARD_FORCE_MOBILE=true
# Preserve the original dashboard's historical account. The active broker
# credentials belong to the isolated $300 trial and must never replace it.
Environment=DASHBOARD_BROKER_ACCOUNT_FALLBACK_ENABLED=false
ExecStart=/home/quantbot/quant-trading-bot/.venv/bin/streamlit run /home/quantbot/quant-trading-bot/dashboard_app.py --server.address 127.0.0.1 --server.port 8502 --server.baseUrlPath mobile --server.headless true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
