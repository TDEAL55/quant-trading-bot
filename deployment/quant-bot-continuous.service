[Unit]
Description=Quant Bot Continuous PAPER Scan Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
User=quantbot
Group=quantbot
WorkingDirectory=/home/quantbot/quant-trading-bot
EnvironmentFile=-/etc/quant-bot/quant-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/quantbot/quant-trading-bot/.venv/bin/python /home/quantbot/quant-trading-bot/continuous_paper_runner.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
